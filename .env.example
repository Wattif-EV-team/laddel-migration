# Copy to .env and fill in real values. Do NOT commit .env.

# MySQL connection (shared host for both databases)
DB_HOST=db.example.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password

# Database names
DB_SOURCE_NAME=laddel
DB_TARGET_NAME=target

# Ampeco Public API (server-to-server). The base URL is your tenant URL; the
# token is a static "API Token" bearer credential.
AMPECO_BASE_URL=https://your-tenant.example.com
AMPECO_API_TOKEN=your_api_token

# eMabler Entity Management API (read-only; source of the per-charger OCPP
# version). The URL is the API root WITHOUT a trailing slash and WITHOUT the
# endpoint's own version prefix, e.g. https://api.emabler.net/api/v2/cpo
# — the client appends paths like /v2/chargers to it.
EMABLER_V2_API_URL=""
EMABLER_V2_API_KEY=""